# The app starts empty. Set this to true to make the server read the supplied evidence (and the case facts)
# by itself instead of waiting for an upload.
LOAD_SUPPLIED_EVIDENCE=

# Folder holding the supplied evidence files (default: ./evidence), used only when LOAD_SUPPLIED_EVIDENCE=true
EVIDENCE_DIR=

# Case facts file used with LOAD_SUPPLIED_EVIDENCE (default: case-pack/CR-26-047.json)
CASE_PACK=

# Supabase: the project URL and its publishable key (Project settings, API keys).
# Never put the secret key in this app or in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Sign-in is required for every app page and for the data API. To switch it off (for example to run the full
# Selenium suite), set both of these to false and restart the server.
NEXT_PUBLIC_REQUIRE_SIGN_IN=
REQUIRE_SIGN_IN=

# Address trust for the simulated gateway. The database believes a source address only from the web route, which
# proves itself with this secret. Make one (for example: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"),
# put it here, and register its SHA-256 hash once in the database:
#   select private.register_gateway_hash('<sha256 hex of the secret>');
GATEWAY_SECRET=
# How many proxies you run in front of the app that append to X-Forwarded-For (default 1 in production, 0 otherwise).
TRUSTED_PROXY_HOPS=
