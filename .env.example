# The app starts empty. Set this to true to make the server read the supplied evidence (and the case facts)
# by itself instead of waiting for an upload.
LOAD_SUPPLIED_EVIDENCE=

# Folder holding the supplied evidence files (default: ./evidence), used only when LOAD_SUPPLIED_EVIDENCE=true
EVIDENCE_DIR=

# Case facts file used with LOAD_SUPPLIED_EVIDENCE (default: case-pack/CR-26-047.json)
CASE_PACK=

# Supabase: the project URL and its publishable key (Project settings, API keys).
# Never put the secret key in this app or in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
